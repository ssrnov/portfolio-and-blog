{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/templates/demo", "destination": "/templates/demo.html" },
    { "source": "/templates/demo/", "destination": "/templates/demo.html" },
    { "source": "/u/:username/resume", "destination": "/u/resume.html" },
    { "source": "/u/:username/resume/", "destination": "/u/resume.html" },
    { "source": "/u/ssrnov", "destination": "/u/ssrnov/index.html" },
    { "source": "/u/ssrnov/", "destination": "/u/ssrnov/index.html" },
    { "source": "/u/sunny", "destination": "/u/sunny/index.html" },
    { "source": "/u/sunny/", "destination": "/u/sunny/index.html" },
    { "source": "/u", "destination": "/u/index.html" },
    { "source": "/u/", "destination": "/u/index.html" },
    { "source": "/u/:username", "destination": "/u/index.html" },
    { "source": "/u/:username/", "destination": "/u/index.html" },
    { "source": "/u/:username/:section*", "destination": "/u/index.html" }
  ]
}
